# MySQL Environment Variables
MYSQL_USER=wordpress
MYSQL_DATABASE=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST=mysql

# WordPress Environment Variables
WORDPRESS_URL=http://localhost:8090
WORDPRESS_TITLE=Ron Ulrich
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=password
WORDPRESS_ADMIN_EMAIL=admin@example.com
WORDPRESS_THEME=ron-ulrich-theme
WP_ENVIRONMENT_TYPE=local
WP_DEBUG=1

# phpMyAdmin Environment Variables
PMA_HOST=mysql
PMA_PORT=3306
PMA_USER=wordpress
PMA_PASSWORD=wordpress
PMA_ROOT_PASSWORD=rootpassword
UPLOAD_LIMIT=64M

# Variables for Automation Scripts
DB_EXPORT_FILE=/db/db-export.sql
DB_IMPORT_FILE=/db/db-import.sql
LOCAL_DOMAIN=localhost:8090
STAGING_DOMAIN=ron-ulrich.justusdeitert.de
PRODUCTION_DOMAIN=www.ron-ulrich.de
