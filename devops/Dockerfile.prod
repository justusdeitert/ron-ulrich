# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS theme-builder

WORKDIR /theme

COPY theme/package.json theme/yarn.lock* theme/package-lock.json* ./
RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then npm ci; \
    else yarn install; fi

COPY theme/ ./
RUN if [ -f yarn.lock ]; then yarn build; else npm run build; fi


FROM php:8.4-fpm AS wp-base

ARG WORDPRESS_VERSION=7.1

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        less \
        mariadb-client \
        libpng-dev \
        libjpeg-dev \
        libfreetype6-dev \
        libwebp-dev \
        libzip-dev \
        libicu-dev \
        unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" mysqli gd zip intl opcache \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ADD --chmod=755 https://raw.githubusercontent.com/vishnubob/wait-for-it/master/wait-for-it.sh /usr/local/bin/wait-for-it.sh

RUN curl -sSL -o /usr/local/bin/wp https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
    && chmod +x /usr/local/bin/wp

WORKDIR /var/www/html

RUN wp core download --version="${WORDPRESS_VERSION}" --allow-root --skip-content \
    && mkdir -p wp-content/themes wp-content/plugins wp-content/uploads

COPY devops/plugins.txt /usr/local/etc/plugins.txt
RUN set -eux; \
    cd wp-content/plugins; \
    while IFS=: read -r slug version _rest; do \
        [ -z "$slug" ] && continue; \
        echo "==> Installing plugin: $slug ($version)"; \
        curl -fsSL -o "${slug}.zip" "https://downloads.wordpress.org/plugin/${slug}.${version}.zip"; \
        unzip -q "${slug}.zip"; \
        rm "${slug}.zip"; \
    done < /usr/local/etc/plugins.txt

COPY theme/ wp-content/themes/ron-ulrich-theme/
COPY --from=theme-builder /theme/assets/ wp-content/themes/ron-ulrich-theme/assets/

COPY devops/php/wp-config.prod.php wp-config.php
COPY devops/php/php.prod.ini /usr/local/etc/php/php.ini

RUN chown -R www-data:www-data /var/www/html


FROM wp-base AS php

COPY --chmod=755 devops/php/entrypoint.prod.sh /usr/local/bin/entrypoint.sh

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]


FROM nginx:1.27-alpine AS nginx

COPY devops/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf
COPY --from=wp-base /var/www/html /var/www/html

EXPOSE 80
